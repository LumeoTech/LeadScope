# ============================================================
# LUMEO CRM — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no Git.
# ============================================================

# ==================== BANCO DE DADOS ====================
# Host do PostgreSQL (Supabase, Render, Railway, etc.)
DB_HOST=

# Porta: 5432 (direto) ou 6543 (Supabase Transaction Pooler — recomendado)
DB_PORT=6543

# Nome do banco
DB_NAME=postgres

# Usuário do banco (ex: postgres.xxxxxxxxxxxxxxxx para Supabase)
DB_USER=

# Senha do banco — OBRIGATÓRIA, sem valor padrão
DB_PASSWORD=

# Parâmetros extras de conexão (não altere se usar Supabase)
DB_PARAMS=?sslmode=require&prepareThreshold=0

# URL completa opcional — sobrescreve DB_HOST/PORT/NAME se definida
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:6543/postgres?sslmode=require&prepareThreshold=0

# ==================== JWT ====================
# OBRIGATÓRIO — Gere com: openssl rand -base64 64
# Mínimo 32 caracteres, nunca use um valor previsível
JWT_SECRET=

# Duração do access token em ms (padrão: 86400000 = 24h)
JWT_ACCESS_EXPIRATION=86400000

# Duração do refresh token em ms (padrão: 604800000 = 7 dias)
JWT_REFRESH_EXPIRATION=604800000

# ==================== SERVIDOR ====================
SERVER_PORT=8080

# ==================== CORS ====================
# Origins permitidas separadas por vírgula
# Ex: https://meuapp.vercel.app,https://meuapp.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== GOOGLE MAPS API ====================
# Necessário para o Scanner de prospecção (Places API)
# Obtenha em: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# ==================== PGADMIN (apenas Docker local) ====================
PGADMIN_EMAIL=admin@lumeo.local
PGADMIN_PASSWORD=

# ==================== FRONTEND ====================
# URL do backend — usado pelo Vite em desenvolvimento e produção
VITE_API_URL=http://localhost:8080
