# ============================================================
# VARIÁVEIS DE AMBIENTE — CRM + SCANNER
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado no Git.
# ============================================================

# ==================== BANCO DE DADOS ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crmdb
DB_USER=crmuser
DB_PASSWORD=crmpassword

# ==================== PGADMIN ====================
PGADMIN_EMAIL=admin@crm.local
PGADMIN_PASSWORD=admin123

# ==================== SERVIDOR ====================
SERVER_PORT=8080

# ==================== JWT ====================
# OBRIGATÓRIO em produção: use uma string aleatória com mínimo 256 bits (32+ caracteres)
# Gere com: openssl rand -base64 64
JWT_SECRET=troque-esta-chave-em-producao-use-string-aleatoria-longa

# Access token: tempo em milissegundos (900000 = 15 minutos)
JWT_ACCESS_EXPIRATION=900000

# Refresh token: tempo em milissegundos (604800000 = 7 dias)
JWT_REFRESH_EXPIRATION=604800000
